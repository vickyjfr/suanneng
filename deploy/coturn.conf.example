listening-port=3478
tls-listening-port=5349
# Replace with the address actually assigned to the ECS network interface.
listening-ip=REPLACE_WITH_ECS_PRIVATE_IP
relay-ip=REPLACE_WITH_ECS_PRIVATE_IP
external-ip=123.56.147.51/REPLACE_WITH_ECS_PRIVATE_IP
realm=se9-files
fingerprint
use-auth-secret
# Generate a random secret and keep it identical to TURN_SHARED_SECRET_FILE.
static-auth-secret=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
min-port=49160
max-port=49260
cert=/etc/se9-turn/fullchain.pem
pkey=/etc/se9-turn/privkey.pem
no-cli
no-multicast-peers
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=::1
no-tcp-relay
stale-nonce=600
user-quota=12
total-quota=100
