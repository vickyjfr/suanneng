# Copy to /etc/se9/se9-file-api.env and set owner root:se9, mode 0640.
STORAGE_ROOT=/vos/workspace/demo
FILE_API_PORT=8443
# Use 127.0.0.1 when only the Agent accesses the API.
# Use the device LAN address or 0.0.0.0 only when LAN App access is enabled.
FILE_API_BIND_ADDR=127.0.0.1
DEMO_ADMIN_PASSWORD=replace-this-before-start
# Random shared secret used only between the local Agent and File API.
SE9_AGENT_PROXY_TOKEN=replace-with-random-32-byte-secret
