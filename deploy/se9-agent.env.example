# Copy to /etc/se9/se9-agent.env and set owner root:se9, mode 0640.
# The Agent derives device ID from the persisted Ed25519 public key.
SE9_KEY_FILE=/var/lib/se9/device.key
# CA bundle used to verify the cloud certificate.
SE9_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# Keep disabled in production. Set to 1 only for isolated local testing.
SE9_TLS_INSECURE=0
SE9_FILE_API_URL=http://127.0.0.1:8443/api/v2
# Must match the File API value; never expose this token to the LAN.
SE9_AGENT_PROXY_TOKEN=replace-with-random-32-byte-secret
