# Cloud API listener
PORT=8443

# Production HTTPS/WSS certificate paths. Both values are required together.
TLS_CERT_FILE=/etc/letsencrypt/live/api.example.com/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/api.example.com/privkey.pem

# Persistent state
AUTH_STATE_FILE=/var/lib/se9-cloud/auth-refresh.json
CLOUD_STATE_FILE=/var/lib/se9-cloud/cloud-state.json

# Replace with a strong secret before deployment.
DEMO_ADMIN_PASSWORD=replace-this-password

# Enable only after verified HTTPS/WSS and a coturn deployment are ready.
RTC_ENABLED=0
RTC_GRANT_KEY_FILE=/var/lib/se9-cloud/rtc-grant.pem
RTC_ALLOW_INSECURE_LOCAL=0
# Set to 1 only behind a trusted reverse proxy connecting over loopback.
RTC_TRUST_PROXY=0
TURN_URLS=turn:123.56.147.51:3478?transport=udp,turn:123.56.147.51:3478?transport=tcp
TURN_SHARED_SECRET_FILE=/etc/se9-cloud/turn-shared-secret
